<?xml version="1.0"?>
<robot name="waveshare_pan_tilt" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="base_y" value="0.003939"/>
  <xacro:property name="base_z" value="-0.020525"/>

  <xacro:property name="tilt_y" value="0.001716"/>
  <xacro:property name="tilt_z" value="0.037805"/>

  <xacro:property name="cam_x" value="-0.025862"/>
  <xacro:property name="cam_y" value="-0.000918"/>
  <xacro:property name="cam_z" value="0.009332"/>

  <xacro:property name="pivot_cam_z" value="0.054"/>

  <xacro:macro name="camera_tilt" params="parent prefix">
    <!-- ========== PAN ========== -->
    <link name="${prefix}pan_link">
      <visual>
        <origin xyz="0 ${base_y} ${base_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://camera_description/meshes/base.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="pan_color">
          <color rgba="0.2 0.2 0.2 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 ${base_y} ${base_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://camera_description/meshes/base.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 ${base_y} ${base_z}" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}pan_joint" type="fixed">
      <parent link="${parent}"/>
      <child  link="${prefix}pan_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14159" upper="3.14159" effort="5" velocity="3"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <!-- ========== TILT ========== -->
    <link name="${prefix}tilt_link">
      <visual>
        <origin xyz="0 ${tilt_y} ${tilt_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://camera_description/meshes/tilt.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="tilt_color">
          <color rgba="0.2 0.2 0.4 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 ${tilt_y} ${tilt_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://camera_description/meshes/tilt.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 ${tilt_y} ${tilt_z}" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${prefix}tilt_joint" type="revolute">
      <parent link="${prefix}pan_link"/>
      <child  link="${prefix}tilt_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.1416" upper="3.1416" effort="5" velocity="3"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>

    <!-- ========== CAMERA ========== -->
    <link name="${prefix}camera_link">
      <visual>
        <origin xyz="${cam_y} ${cam_x} ${cam_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://camera_description/meshes/camera.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="camera_color">
          <color rgba="0.2 0.4 0.4 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="${cam_y} ${cam_x} ${cam_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://camera_description/meshes/camera.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${cam_y} ${cam_x} ${cam_z}" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.0005" iyy="0.0005" izz="0.0005"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <!-- камера жёстко прикручена к tilt -->
    <joint name="${prefix}camera_joint" type="revolute">
      <parent link="${prefix}tilt_link"/>
      <child  link="${prefix}camera_link"/>
      <!-- cam_x/y/z подгони так, чтобы меш камеры встал на своё место -->
      <origin xyz="0 0 ${pivot_cam_z}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.5708" upper="0.7854" effort="5" velocity="3"/>
      <dynamics damping="0.1" friction="0.0"/>
    </joint>
  </xacro:macro>
</robot>