{
  "name": "camera-tilt-ros2 (Jazzy)",
  "privileged": true,
  "remoteUser": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
  },
  "workspaceFolder": "/ws",
  "workspaceMount": "source=${localWorkspaceFolder},target=/ws,type=bind,consistency=cached",
  "runArgs": [
    "--net=host",
    "-e",
    "DISPLAY=${env:DISPLAY}"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "twxs.cmake"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "cmake.configureOnOpen": false
      }
    }
  },
  "postCreateCommand": "bash -lc 'cd /ws && rosdep update && rosdep install --from-paths . --ignore-src -r -y || true'"
}